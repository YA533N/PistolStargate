# Godot 4 cache (rebuilt on open; never commit)
.godot/
/android/

# .NET leftovers. The project is GDScript-only, but the .NET editor can create these.
.mono/
data_*/
mono_crash.*.json

# Exported builds
/builds/

# Per-machine editor settings (each teammate's Godot path differs)
.vscode/settings.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Downloaded asset archives: unzip the textures into assets/textures/<asset>/ and commit those instead
*.zip
*.7z
*.rar

# Blender backups and other temp files
*.blend1
*.blend2
*.tmp
*.log
*.orig

# Exported game files
*.exe
*.pck

# Other editors' per-machine folders
.idea/
.vs/
